<?xml version="1.0" encoding="utf-8" ?>
<configuration>
  <configSections>
    <section name="log4net" type="log4net.Config.Log4NetConfigurationSectionHandler, Log4net"/>
    <section name="clipperSettings" type="System.Configuration.NameValueSectionHandler" />
  </configSections>
  <startup>
      <supportedRuntime version="v2.0.50727" />
      <supportedRuntime version="v4.0" /> 
  </startup>
  <clipperSettings>
     <add key="registryBranchMode" value="fixed" />  
     <add key="registryBranchValue" value="Yinxiang Biji" />  
  </clipperSettings>
  <log4net>
    <root>
      <level value="DEBUG" />
      <appender-ref ref="FileAppender"/>
    </root>
    <appender name="FileAppender" type="log4net.Appender.RollingFileAppender" >
      <encoding value="utf-8" />
      <file type="log4net.Util.PatternString">
        <converter>
          <name value="knownFolder" />
          <type value="YinXiangBiJiOLRDClipper.Common.KnownFolderConverter,YinXiangBiJiOLRDClipper" />
        </converter>
        <conversionPattern value="%knownFolder{A520A1A4-1780-4FF6-BD18-167343C5AF16}\Yinxiang Biji\Yinxiang Biji\Logs\OLRDClipper_.txt" />
      </file>
      <datePattern value="yyyy-MM-dd" />
      <maxSizeRollBackups value="5"/>
      <maximumFileSize value="200KB"/>

      <appendToFile value="true" />
      <rollingStyle value="Composite" />
      <preserveLogFileNameExtension value="true"/>
      <staticLogFileName value="false" />
     
      <layout type="log4net.Layout.PatternLayout">
        <param name="ConversionPattern" value="%d{yyyy-MM-dd hh:mm:ss} %-6level [%-6thread] - %m%n%exception" />
      </layout>
    </appender>
  </log4net>
</configuration>
